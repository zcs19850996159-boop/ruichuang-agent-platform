HOST=0.0.0.0
PORT=8765
PYTHON_BIN=/usr/local/bin/python

APPLICATION_VERSION=3.5.1
KNOWLEDGE_VERSION=competition-kb-v1
MODEL_CONFIGURATION_VERSION=model-config-v1
PROMPT_VERSION=prompt-v1
CUSTOMER_SERVICE_PROFILE=competition
KNOWLEDGE_SPACE_ID=competition

API_AUTH_REQUIRED=1
KAFU_API_TOKEN=replace-me
API_MAX_CONCURRENCY=4
API_REQUEST_TIMEOUT=120
API_RATE_LIMIT_PER_MINUTE=60
API_MAX_BODY_BYTES=16777216

DEEPSEEK_API_KEY=replace-me
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TEMPERATURE=0.1

VISION_ENABLED=1
VISION_BASE_URL=http://127.0.0.1:8001/v1
VISION_API_KEY=local-vision
VISION_MODEL=Qwen2.5-VL-3B-Instruct
VISION_TIMEOUT=45

HYBRID_INDEX_DIR=outputs/rag_assets/hybrid_index_v3
HYBRID_RETRIEVAL_ENABLED=1
HYBRID_ENFORCE_CONFIDENCE=1
RETRIEVAL_CACHE_VERSION=hybrid-v3

REDIS_URL=redis://127.0.0.1:6379/0
# Phase 2 tool adapters and managed knowledge
KNOWLEDGE_STORE_ROOT=knowledge_store
KNOWLEDGE_MAX_UPLOAD_BYTES=104857600
KNOWLEDGE_REQUIRE_VIRUS_SCAN=0
KNOWLEDGE_OCR_PROVIDER=
KNOWLEDGE_OCR_LANGUAGE=chi_sim+eng
KNOWLEDGE_REQUIRE_REGRESSION=0
KNOWLEDGE_REQUIRE_VECTOR_INDEX=0
KNOWLEDGE_PACKAGE_MAX_ENTRIES=2000
KNOWLEDGE_PACKAGE_MAX_UNCOMPRESSED_BYTES=524288000
# Enterprise managed versions reuse the Ruichuang hybrid-RAG strategy but keep
# a separate per-version index. Leave blank only when explicit lexical fallback
# is acceptable in development.
MANAGED_HYBRID_EMBEDDING_MODEL=models/multilingual-e5-small
MANAGED_HYBRID_DEVICE=cpu
MANAGED_HYBRID_BATCH_SIZE=32
KNOWLEDGE_ADMIN_TOKEN=replace-with-a-separate-admin-token
CUSTOMER_MCP_EXPOSURE=realtime
CUSTOMER_MCP_ALLOW_ADMIN=0
CUSTOMER_MCP_CUSTOMER_PROFILE=competition
CUSTOMER_MCP_TENANT_ID=default
CUSTOMER_MCP_KNOWLEDGE_SPACE_ID=competition

# Phase 3 enterprise control plane (disabled by default)
CLOUD_CONTROL_ENABLED=0
# Development/acceptance fallback:
CONTROL_PLANE_DB=outputs/control/control-plane.sqlite3
# Phase 3C production:
CONTROL_PLANE_DATABASE_URL=
CONTROL_PLANE_REQUIRE_POSTGRES=0
CONTROL_PLANE_DB_POOL_MIN=1
CONTROL_PLANE_DB_POOL_MAX=8
CONTROL_PLANE_DB_CONNECT_TIMEOUT=10
CONTROL_PLANE_TOKEN_PEPPER=replace-with-at-least-32-random-bytes
CONTROL_PLANE_BOOTSTRAP_TOKEN=replace-with-a-separate-bootstrap-token

# Phase 3C immutable object storage. Keep "local" for development.
KNOWLEDGE_OBJECT_STORE_BACKEND=local
KNOWLEDGE_OBJECT_STORE_BUCKET=
KNOWLEDGE_OBJECT_STORE_PREFIX=ruichuang/knowledge
KNOWLEDGE_OBJECT_STORE_ENDPOINT=
KNOWLEDGE_OBJECT_STORE_REGION=
KNOWLEDGE_OBJECT_STORE_SSE=

# Production fail-closed checks and trusted ingress.
DEPLOYMENT_MODE=development
API_DEBUG=0
API_CORS_ORIGINS=http://127.0.0.1:8765
API_TRUST_PROXY_HEADERS=0
API_TRUSTED_PROXY_IPS=127.0.0.1,::1
